    "allow-new-theme",
    "allow-import-theme",
    "allow-add-image",
    "allow-add-icon",
    "allow-add-media",
    "allow-list-assets",
    "allow-list-fonts",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-storage-overview",
    "allow-media-tools",
    "allow-locate-ffmpeg",
    "allow-pick-media",
